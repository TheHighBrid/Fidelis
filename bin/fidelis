#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail

readonly APP_HOME="${FIDELIS_HOME:-$HOME/.local/share/fidelis}"
readonly COLAB_URL="https://colab.research.google.com/github/TheHighBrid/Fidelis/blob/main/notebooks/Fidelis_VOSR2_Colab.ipynb"

usage() {
  cat <<'EOF'
Usage:
  fidelis open       Open the verified VOSR 2.0 notebook
  fidelis doctor     Show the installed Fidelis architecture
EOF
}

open_colab() {
  if command -v termux-open-url >/dev/null 2>&1; then
    termux-open-url "$COLAB_URL"
  elif command -v am >/dev/null 2>&1; then
    am start -a android.intent.action.VIEW -d "$COLAB_URL" >/dev/null
  else
    printf '%s\n' "$COLAB_URL"
  fi
}

doctor() {
  printf 'Architecture: %s\n' "$(uname -m)"
  printf 'Termux prefix: %s\n' "${PREFIX:-not set}"
  printf 'Fidelis backend: VOSR 2.0 on interactive Google Colab\n'
  printf 'Legacy NCNN backend: retired\n'
  [[ -f "$APP_HOME/install.json" ]] && cat "$APP_HOME/install.json"
}

command="${1:-}"
case "$command" in
  open) open_colab ;;
  doctor) doctor ;;
  upscale|batch|models)
    printf 'This command belonged to the retired NCNN prototype and is disabled because it produced corrupted images.\n' >&2
    printf 'Run: fidelis open\n' >&2
    exit 2
    ;;
  -h|--help|help|'') usage ;;
  *) printf 'Unknown command: %s\n' "$command" >&2; usage >&2; exit 2 ;;
esac

