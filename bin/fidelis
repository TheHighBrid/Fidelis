#!/usr/bin/env bash
set -Eeuo pipefail

readonly APP_HOME="${FIDELIS_HOME:-$HOME/.local/share/fidelis}"
readonly RUNTIME="$APP_HOME/runtime"
repo_root="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd || echo "")"

resolve_python() {
  if [[ -n "$repo_root" && -x "$repo_root/.venv/bin/python" ]]; then
    printf '%s\n' "$repo_root/.venv/bin/python"
  elif command -v python3 >/dev/null 2>&1; then
    printf 'python3\n'
  else
    printf 'python\n'
  fi
}

ENGINE="${FIDELIS_ENGINE:-$RUNTIME/realsr-ncnn}"
if [[ ! -x "$ENGINE" && -x "$RUNTIME/realsr-ncnn-vulkan" ]]; then
  ENGINE="$RUNTIME/realsr-ncnn-vulkan"
fi
readonly ENGINE
readonly DEFAULT_MODEL="${FIDELIS_MODEL:-ESRGAN-Nomos8kSC}"

usage() {
  cat <<'EOF'
Usage:
  fidelis doctor
  fidelis models
  fidelis model-info MODEL
  fidelis model-add MODEL PARAM_FILE BIN_FILE [--replace]
  fidelis upscale INPUT OUTPUT [--model MODEL]
  fidelis batch INPUT_DIR OUTPUT_DIR [--model MODEL]
  fidelis audition INPUT OUTPUT_DIR [MODEL ...]
  fidelis batch-audition INPUT_DIR OUTPUT_DIR [MODEL ...]
  fidelis evaluate RESULTS_DIR
  fidelis detect-drift RESULTS_DIR [--strict]
  fidelis heatmap SOURCE [UPSCALED] [-o OUT_PNG]
  fidelis benchmark-macos [INPUT] [OUTPUT_DIR]
  fidelis report RESULTS_DIR [-o OUT_HTML]
  fidelis eval-crops [-d TARGET_DIR]
  fidelis ui [-p PORT]

MODEL is the installed directory name without the leading "models-".
The current local engine contract is 4x NCNN RealSR/ESRGAN: x4.param + x4.bin.

Examples:
  fidelis model-add PhotoCandidate ./candidate.param ./candidate.bin
  fidelis model-info PhotoCandidate
  fidelis upscale photo.jpg out.png --model PhotoCandidate
  fidelis audition photo.jpg ./audition PhotoCandidate ESRGAN-Nomos8kSC
  FIDELIS_MODEL=PhotoCandidate fidelis upscale photo.jpg out.png
EOF
}

require_engine() {
  [[ -x "$ENGINE" ]] || {
    printf 'Fidelis runtime is not installed. Run ./install.sh first.\n' >&2
    exit 1
  }
  export LD_LIBRARY_PATH="$RUNTIME${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
}

if ! command -v sha256sum >/dev/null 2>&1 && command -v shasum >/dev/null 2>&1; then
  sha256sum() {
    shasum -a 256 "$@"
  }
fi

require_registry_tools() {
  command -v jq >/dev/null 2>&1 || { printf 'jq is required. Run: pkg install jq\n' >&2; exit 1; }
  command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1 || { printf 'sha256sum (or shasum) is required.\n' >&2; exit 1; }
}

canonical_path() {
  local target="$1"
  if command -v realpath >/dev/null 2>&1; then
    if realpath -m . >/dev/null 2>&1; then
      realpath -m "$target"
      return
    elif realpath "$target" >/dev/null 2>&1; then
      realpath "$target"
      return
    fi
  fi
  local dir base
  dir="$(dirname "$target")"
  base="$(basename "$target")"
  while [[ ! -d "$dir" && "$dir" != "/" && "$dir" != "." ]]; do
    base="$(basename "$dir")/$base"
    dir="$(dirname "$dir")"
  done
  if [[ -d "$dir" ]]; then
    local resolved_dir
    resolved_dir="$(cd "$dir" && pwd -P)"
    if [[ "$resolved_dir" == "/" ]]; then
      printf '/%s\n' "$base"
    else
      printf '%s/%s\n' "$resolved_dir" "$base"
    fi
  else
    [[ "$target" = /* ]] && printf '%s\n' "$target" || printf '%s/%s\n' "$(pwd -P)" "$target"
  fi
}

normalize_model_name() {
  local name="${1#models-}"
  [[ -n "$name" && "$name" =~ ^[A-Za-z0-9._-]+$ ]] || {
    printf 'Invalid model name: %s\nUse only letters, numbers, dot, underscore, and hyphen.\n' "$1" >&2
    return 2
  }
  printf '%s\n' "$name"
}

resolve_model() {
  local selector
  selector="$(normalize_model_name "${1:-$DEFAULT_MODEL}")" || return
  local model="$RUNTIME/models-$selector"
  [[ -d "$model" ]] || {
    printf 'Model is not installed: %s\n' "$selector" >&2
    return 1
  }
  [[ -s "$model/x4.param" && -s "$model/x4.bin" ]] || {
    printf 'Model is incomplete (expected non-empty x4.param + x4.bin): %s\n' "$selector" >&2
    return 1
  }
  printf '%s\n' "$model"
}

list_models() {
  local dir base
  [[ -d "$RUNTIME" ]] || return 0
  while IFS= read -r dir; do
    [[ -s "$dir/x4.param" && -s "$dir/x4.bin" ]] || continue
    base="$(basename "$dir")"
    printf '%s\n' "${base#models-}"
  done < <(find "$RUNTIME" -maxdepth 1 -mindepth 1 -type d -name 'models-*' -print | sort)
}

model_info() {
  local selector model metadata live_param_sha live_bin_sha
  selector="$(normalize_model_name "$1")"
  model="$(resolve_model "$selector")"
  metadata="$model/fidelis-model.json"
  live_param_sha="$(sha256sum "$model/x4.param" | awk '{print $1}')"
  live_bin_sha="$(sha256sum "$model/x4.bin" | awk '{print $1}')"

  if [[ -s "$metadata" ]]; then
    jq -e . "$metadata" >/dev/null 2>&1 || {
      printf 'Model registry metadata is invalid JSON: %s\n' "$selector" >&2
      return 1
    }

    local registered_param_sha registered_bin_sha
    registered_param_sha="$(jq -r '.sha256.param // empty' "$metadata")"
    registered_bin_sha="$(jq -r '.sha256.bin // empty' "$metadata")"
    if [[ -z "$registered_param_sha" || -z "$registered_bin_sha" ]]; then
      printf 'Model registry metadata is missing SHA-256 provenance: %s\n' "$selector" >&2
      return 1
    fi
    if [[ "$registered_param_sha" != "$live_param_sha" || "$registered_bin_sha" != "$live_bin_sha" ]]; then
      printf 'Model integrity mismatch: %s\nRegistered hashes do not match the installed NCNN files. Re-add the model explicitly.\n' "$selector" >&2
      return 1
    fi

    cat "$metadata"
    return
  fi

  # Legacy/upstream bundled models predate the Fidelis registry. Report live
  # hashes without mutating them so provenance remains explicit.
  jq -n \
    --arg name "$selector" \
    --arg engine "realsr-ncnn" \
    --arg format "ncnn" \
    --argjson scale 4 \
    --arg param_sha256 "$live_param_sha" \
    --arg bin_sha256 "$live_bin_sha" \
    '{name:$name,engine:$engine,format:$format,scale:$scale,registry:"legacy-unregistered",sha256:{param:$param_sha256,bin:$bin_sha256}}'
}

model_add() {
  local selector param_file bin_file replace="${4:-}"
  selector="$(normalize_model_name "$1")"
  param_file="$(canonical_path "$2")"
  bin_file="$(canonical_path "$3")"

  [[ -s "$param_file" ]] || { printf 'NCNN param file is missing or empty: %s\n' "$2" >&2; exit 1; }
  [[ -s "$bin_file" ]] || { printf 'NCNN bin file is missing or empty: %s\n' "$3" >&2; exit 1; }
  [[ "$replace" == "" || "$replace" == "--replace" ]] || {
    printf 'Expected optional flag: --replace\n' >&2
    exit 2
  }

  require_engine
  require_registry_tools

  local dest="$RUNTIME/models-$selector"
  if [[ -e "$dest" && "$replace" != "--replace" ]]; then
    printf 'Model already exists: %s\nUse --replace to replace it atomically.\n' "$selector" >&2
    exit 1
  fi

  local tmp="$RUNTIME/.models-$selector.new.$$"
  rm -rf "$tmp"
  mkdir -p "$tmp"
  trap 'rm -rf "$tmp"' RETURN

  cp "$param_file" "$tmp/x4.param"
  cp "$bin_file" "$tmp/x4.bin"

  local param_sha bin_sha installed_at
  param_sha="$(sha256sum "$tmp/x4.param" | awk '{print $1}')"
  bin_sha="$(sha256sum "$tmp/x4.bin" | awk '{print $1}')"
  installed_at="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"

  jq -n \
    --arg name "$selector" \
    --arg engine "realsr-ncnn" \
    --arg format "ncnn" \
    --argjson scale 4 \
    --arg installed_at "$installed_at" \
    --arg param_sha256 "$param_sha" \
    --arg bin_sha256 "$bin_sha" \
    '{schema_version:1,name:$name,engine:$engine,format:$format,scale:$scale,installed_at:$installed_at,sha256:{param:$param_sha256,bin:$bin_sha256}}' \
    > "$tmp/fidelis-model.json"

  # Verify the staged files before the old model, if any, is touched.
  [[ "$(sha256sum "$tmp/x4.param" | awk '{print $1}')" == "$param_sha" ]]
  [[ "$(sha256sum "$tmp/x4.bin" | awk '{print $1}')" == "$bin_sha" ]]

  local backup=""
  if [[ -e "$dest" ]]; then
    backup="$RUNTIME/.models-$selector.old.$$"
    rm -rf "$backup"
    mv "$dest" "$backup"
  fi

  if ! mv "$tmp" "$dest"; then
    [[ -n "$backup" && -e "$backup" ]] && mv "$backup" "$dest"
    printf 'Failed to activate model: %s\n' "$selector" >&2
    exit 1
  fi
  [[ -n "$backup" ]] && rm -rf "$backup"
  trap - RETURN

  printf 'Installed model: %s\n' "$selector"
  printf '  param sha256: %s\n' "$param_sha"
  printf '  bin   sha256: %s\n' "$bin_sha"
}

parse_model_option() {
  if [[ $# -eq 0 ]]; then
    printf '%s\n' "$DEFAULT_MODEL"
    return
  fi
  if [[ $# -eq 2 && "$1" == "--model" && -n "$2" ]]; then
    normalize_model_name "$2"
    return
  fi
  printf 'Expected optional: --model MODEL\n' >&2
  return 2
}

doctor() {
  printf 'Architecture: %s\n' "$(uname -m)"
  printf 'Termux prefix: %s\n' "${PREFIX:-not set}"
  printf 'KGSL device: %s\n' "$([[ -e /dev/kgsl-3d0 ]] && printf visible || printf missing)"
  printf 'Runtime: %s\n' "$([[ -x "$ENGINE" ]] && printf installed || printf missing)"
  printf 'Default model: %s\n' "$DEFAULT_MODEL"

  local default_path
  if default_path="$(resolve_model "$DEFAULT_MODEL" 2>/dev/null)"; then
    printf 'Default model status: installed\n'
  else
    printf 'Default model status: missing/incomplete\n'
  fi

  printf 'Installed usable models:\n'
  local models
  models="$(list_models || true)"
  if [[ -n "$models" ]]; then
    printf '%s\n' "$models" | sed 's/^/  - /'
  else
    printf '  (none)\n'
  fi

  [[ -f "$APP_HOME/install.json" ]] && cat "$APP_HOME/install.json"
  if [[ -x "$ENGINE" ]]; then
    require_engine
    printf '\nEngine probe:\n'
    "$ENGINE" -h 2>&1 | sed -n '1,25p' || true
  fi
}

run_upscale() {
  local input="$1" output="$2" selector="${3:-$DEFAULT_MODEL}"
  [[ -e "$input" ]] || {
    printf 'Input not found: %s\n' "$input" >&2
    exit 1
  }
  mkdir -p "$(dirname "$output")"
  require_engine
  local model
  model="$(resolve_model "$selector")"
  (cd "$RUNTIME" && "$ENGINE" -i "$input" -o "$output" -m "$model" -s 4 -t 256)
}

audition() {
  local input="$1" output_dir="$2"
  shift 2
  [[ -f "$input" ]] || {
    printf 'Audition input must be one image file: %s\n' "$input" >&2
    exit 1
  }
  mkdir -p "$output_dir"
  require_engine
  require_registry_tools

  local -a models=()
  if [[ $# -gt 0 ]]; then
    models=("$@")
  else
    while IFS= read -r line; do
      [[ -n "$line" ]] && models+=("$line")
    done < <(list_models)
  fi
  [[ ${#models[@]} -gt 0 ]] || {
    printf 'No usable models are installed.\n' >&2
    exit 1
  }

  # A new run invalidates prior evidence immediately. The manifest is published
  # atomically only after every selected model produces a non-empty output.
  rm -f "$output_dir/manifest.json"
  local entries_file="$output_dir/.fidelis-audition-entries.$$"
  local manifest_tmp="$output_dir/.manifest.json.new.$$"
  rm -f "$entries_file" "$manifest_tmp"
  : > "$entries_file"
  trap 'rm -f "$entries_file" "$manifest_tmp"' RETURN

  local selector safe output provenance output_sha output_bytes
  for selector in "${models[@]}"; do
    selector="$(normalize_model_name "$selector")"
    provenance="$(model_info "$selector")"
    safe="${selector//[^A-Za-z0-9._-]/_}"
    output="$output_dir/${safe}.png"
    rm -f "$output"
    printf '\n[%s] -> %s\n' "$selector" "$output"
    run_upscale "$input" "$output" "$selector"
    if [[ ! -s "$output" ]]; then
      printf 'Model audition failed: %s exited without producing a non-empty output.\n' "$selector" >&2
      rm -f "$output"
      return 1
    fi

    output_sha="$(sha256sum "$output" | awk '{print $1}')"
    output_bytes="$(wc -c < "$output" | tr -d '[:space:]')"
    jq -cn \
      --argjson model "$provenance" \
      --arg filename "$(basename "$output")" \
      --arg sha256 "$output_sha" \
      --argjson bytes "$output_bytes" \
      '{model:$model,output:{filename:$filename,bytes:$bytes,sha256:$sha256}}' \
      >> "$entries_file"
  done

  local created_at input_sha input_bytes engine_sha
  created_at="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
  input_sha="$(sha256sum "$input" | awk '{print $1}')"
  input_bytes="$(wc -c < "$input" | tr -d '[:space:]')"
  engine_sha="$(sha256sum "$ENGINE" | awk '{print $1}')"

  jq -s \
    --arg created_at "$created_at" \
    --arg input_path "$input" \
    --arg input_sha256 "$input_sha" \
    --argjson input_bytes "$input_bytes" \
    --arg engine_sha256 "$engine_sha" \
    '{schema_version:1,command:"fidelis audition",created_at:$created_at,input:{path:$input_path,bytes:$input_bytes,sha256:$input_sha256},engine:{name:"realsr-ncnn",sha256:$engine_sha256},models:.}' \
    "$entries_file" > "$manifest_tmp"
  mv "$manifest_tmp" "$output_dir/manifest.json"
  rm -f "$entries_file"
  trap - RETURN

  printf '\nAudition complete: %d model(s).\n' "${#models[@]}"
  printf 'Manifest: %s\n' "$output_dir/manifest.json"
}

command="${1:-}"
case "$command" in
  doctor)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    doctor
    ;;
  models)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    require_engine
    list_models
    ;;
  model-info)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    require_engine
    require_registry_tools
    model_info "$2"
    ;;
  model-add)
    [[ $# -eq 4 || $# -eq 5 ]] || { usage >&2; exit 2; }
    model_add "$2" "$3" "$4" "${5:-}"
    ;;
  upscale)
    [[ $# -ge 3 ]] || { usage >&2; exit 2; }
    input_file="$2"
    output_file="$3"
    is_tiled=false
    model="$DEFAULT_MODEL"
    shift 3 || true
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --model) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; model="$(normalize_model_name "$2")"; shift 2 ;;
        --tiled) is_tiled=true; shift ;;
        *) usage >&2; exit 2 ;;
      esac
    done
    if [[ "$is_tiled" == true ]]; then
      py="$(resolve_python)"
      "$py" "$repo_root/scripts/tiled-upscale.py" "$(canonical_path "$input_file")" "$(canonical_path "$output_file")" --model "$model"
    else
      run_upscale "$(canonical_path "$input_file")" "$(canonical_path "$output_file")" "$model"
    fi
    ;;
  batch)
    [[ $# -eq 3 || $# -eq 5 ]] || { usage >&2; exit 2; }
    [[ -d "$2" ]] || { printf 'Input directory not found: %s\n' "$2" >&2; exit 1; }
    model="$(parse_model_option "${@:4}")"
    run_upscale "$(canonical_path "$2")" "$(canonical_path "$3")" "$model"
    ;;
  audition)
    [[ $# -ge 3 ]] || { usage >&2; exit 2; }
    input="$(canonical_path "$2")"
    output_dir="$(canonical_path "$3")"
    shift 3
    audition "$input" "$output_dir" "$@"
    ;;
  batch-audition)
    [[ $# -ge 3 ]] || { usage >&2; exit 2; }
    batch_aud_script="$repo_root/scripts/batch-audition.sh"
    [[ -f "$batch_aud_script" ]] || { printf 'Batch audition script not found: %s\n' "$batch_aud_script" >&2; exit 1; }
    shift
    exec bash "$batch_aud_script" "$@"
    ;;
  evaluate)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    py="$(resolve_python)"
    eval_script="$repo_root/scripts/evaluate-fidelity-metrics.py"
    [[ -f "$eval_script" ]] || { printf 'Metrics evaluator not found: %s\n' "$eval_script" >&2; exit 1; }
    "$py" "$eval_script" "$2"
    ;;
  detect-drift)
    [[ $# -ge 2 ]] || { usage >&2; exit 2; }
    py="$(resolve_python)"
    drift_script="$repo_root/scripts/detect-drift.py"
    [[ -f "$drift_script" ]] || { printf 'Drift detector not found: %s\n' "$drift_script" >&2; exit 1; }
    shift
    "$py" "$drift_script" "$@"
    ;;
  heatmap)
    [[ $# -ge 2 ]] || { usage >&2; exit 2; }
    py="$(resolve_python)"
    heatmap_script="$repo_root/scripts/generate-delta-heatmap.py"
    [[ -f "$heatmap_script" ]] || { printf 'Heatmap generator not found: %s\n' "$heatmap_script" >&2; exit 1; }
    shift
    "$py" "$heatmap_script" "$@"
    ;;
  benchmark-macos)
    bench_script="$repo_root/scripts/macos-benchmark.sh"
    [[ -f "$bench_script" ]] || { printf 'macOS benchmark script not found: %s\n' "$bench_script" >&2; exit 1; }
    shift
    exec bash "$bench_script" "$@"
    ;;
  report)
    [[ $# -ge 2 ]] || { usage >&2; exit 2; }
    py="$(resolve_python)"
    report_script="$repo_root/scripts/generate-audition-report.py"
    [[ -f "$report_script" ]] || { printf 'Report generator not found: %s\n' "$report_script" >&2; exit 1; }
    shift
    "$py" "$report_script" "$@"
    ;;
  eval-crops)
    py="$(resolve_python)"
    fetch_script="$repo_root/scripts/fetch-eval-crops.py"
    [[ -f "$fetch_script" ]] || { printf 'Crops generator not found: %s\n' "$fetch_script" >&2; exit 1; }
    shift
    "$py" "$fetch_script" "$@"
    ;;
  ui)
    py="$(resolve_python)"
    ui_script="$repo_root/scripts/web-ui.py"
    [[ -f "$ui_script" ]] || { printf 'Web UI script not found: %s\n' "$ui_script" >&2; exit 1; }
    shift
    exec "$py" "$ui_script" "$@"
    ;;
  -h|--help|help|'') usage ;;
  *) printf 'Unknown command: %s\n' "$command" >&2; usage >&2; exit 2 ;;
esac
